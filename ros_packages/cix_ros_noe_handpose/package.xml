<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>cix_ros_noe_handpose</name>
  <version>0.1.0</version>
  <description>NPU hand pose (C++): zero-copy dmabuf inference, publishes 21 keypoints (HandPoseKeypoints) and the index-finger direction as Vector3</description>
  <maintainer email="noreply@cixtech.com">CIX Robotics team</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <buildtool_depend>ament_cmake_python</buildtool_depend>
  <buildtool_depend>rosidl_default_generators</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>std_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>libopencv-dev</depend>
  <depend>cix_ros_dmabuf</depend>
  <depend>ament_index_cpp</depend>

  <exec_depend>rosidl_default_runtime</exec_depend>

  <!-- msg/HandPoseKeypoints.msg is generated by rosidl -->
  <member_of_group>rosidl_interface_packages</member_of_group>

  <!-- The Python inference node (handpose_dma_teleop) needs rclpy at
       runtime. The main inference node is C++. -->
  <exec_depend>rclpy</exec_depend>
  <exec_depend>ament_index_python</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
